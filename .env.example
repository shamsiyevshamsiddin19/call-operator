# ─────────────────────────────────────────────────────────────────────────────
# 12-Factor konfiguratsiya namunasi.
# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring.
# .env fayli hech qachon git'ga tushmaydi (.gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=almashtiring-tasodifiy-50-belgi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Ma'lumotlar bazasi (PostgreSQL majburiy — SQLite qo'llab-quvvatlanmaydi:
# loyiha CheckConstraint, PL/pgSQL triggerlari, pg_trgm va SELECT FOR UPDATE ga tayanadi)
#
# 1-variant — docker compose bilan (5433 porti, to'qnashuvdan qochish uchun):
DATABASE_URL=postgres://call_operator:dev_parol_almashtiring@localhost:5433/call_operator
#
# 2-variant — mashinada o'rnatilgan PostgreSQL, unix socket va peer auth bilan
# (parol kerak emas, host bo'sh qoldiriladi):
# DATABASE_URL=postgres://<sizning_foydalanuvchingiz>@/call_operator
DB_CONN_MAX_AGE=60
DB_LOCK_TIMEOUT_MS=3000
DB_LOG_LEVEL=INFO

# Redis (kesh, sessiya holati, Celery broker)
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# Biznes qoidalari (hardcode taqiqlangani uchun shu yerda sozlanadi)
# ─────────────────────────────────────────────────────────────────────────────
# INV-07: rezervatsiya qancha vaqtdan keyin avtomatik bekor bo'ladi
RESERVATION_TTL_MINUTES=15

# Qoldiq shu sondan kam bo'lsa mijozga aniq son aytiladi ("3 dona qoldi")
LOW_STOCK_DISCLOSURE_THRESHOLD=5

# INV-06: bir telefon raqamdan daqiqada ruxsat etilgan qo'ng'iroq soni
CALL_RATE_LIMIT_PER_MINUTE=3

# Maxfiylik: qo'ng'iroq yozuvi va transkript necha kundan keyin o'chadi
RECORDING_RETENTION_DAYS=90

# ─────────────────────────────────────────────────────────────────────────────
# M2 — Ovoz kanali (hozir ishlatilmaydi, M2 bosqichida to'ldiriladi)
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# Gemini VAD: gap tugaganini kutish oynasi. 500 ms dan kam qilish xavfli —
# o'zbek tilida o'ylab turgan mijozning gapi bo'lib qo'yiladi.
# VAD_SILENCE_MS=500
# ASTERISK_ARI_URL=http://localhost:8088/ari
# ASTERISK_ARI_USER=
# ASTERISK_ARI_PASSWORD=
# AUDIOSOCKET_HOST=0.0.0.0
# AUDIOSOCKET_PORT=9092

# ─────────────────────────────────────────────────────────────────────────────
# M3 — Telegram (hozir ishlatilmaydi)
# ─────────────────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Opt-in deep-link tokenini imzolash kaliti (INV-17)
# TELEGRAM_OPTIN_SECRET=
# TELEGRAM_OPTIN_TTL_MINUTES=15

# ─────────────────────────────────────────────────────────────────────────────
# M4 — Instagram (hozir ishlatilmaydi)
# ─────────────────────────────────────────────────────────────────────────────
# INSTAGRAM_PAGE_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# INSTAGRAM_APP_SECRET=
# Meta limiti: 750 private reply/soat. Xavfsizlik zahirasi bilan pastroq qo'yiladi.
# INSTAGRAM_PRIVATE_REPLY_PER_HOUR=700

# ─────────────────────────────────────────────────────────────────────────────
# SMS provayderi (Telegram opt-in havolasi va raqam tasdiqlash uchun)
# ─────────────────────────────────────────────────────────────────────────────
# SMS_PROVIDER_URL=
# SMS_PROVIDER_TOKEN=
